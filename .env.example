# Copie ce fichier en ".env" puis modifie les valeurs (surtout les mots de passe)
# COMPOSE_PROJECT_NAME isole ce projet des autres containers/volumes/réseaux Docker
# deja presents sur la machine. Tous les objets Docker crees porteront le prefixe "wfm_".
COMPOSE_PROJECT_NAME=wfm

# ---- PostgreSQL (une seule instance, plusieurs bases : wfm_app, airflow, mlflow) ----
POSTGRES_USER=wfm_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_APP_DB=wfm_app
# Port host expose volontairement sur 5433 (pas 5432) pour ne pas entrer en conflit
# avec un Postgres local ou un autre projet qui utiliserait deja le port par defaut.
POSTGRES_PORT=5433

# ---- MinIO (data lake S3-compatible) ----
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Airflow ----
AIRFLOW_PORT=8081
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Genere une vraie cle avec la commande fournie dans le README avant de lancer en "serieux".
# Une valeur vide fait qu'Airflow generera une cle a la volee (OK pour du dev local).
AIRFLOW_FERNET_KEY=

# ---- MLflow ----
MLFLOW_PORT=5001
